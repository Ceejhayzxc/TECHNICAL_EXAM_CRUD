@model EXAM.CRUD.Models.Persons

<div class="modal fade" id="createModal" tabindex="-1" aria-labelledby="createModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="createModalLabel">Create Form</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <form asp-action="CreatePerson" method="post" novalidate>
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="firstName" class="form-label"></label>
                            <input asp-for="firstName" class="form-control" placeholder="ex: Juan" />
                            <span asp-validation-for="firstName" class="text-danger"></span>
                        </div>

                        <div class="col-md-3 mb-3">
                            <label asp-for="middleName" class="form-label"></label>
                            <input asp-for="middleName" class="form-control" type="text" placeholder="ex: Santos" />
                            <span asp-validation-for="middleName" class="text-danger"></span>
                        </div>

                        <div class="col-md-3 mb-3">
                            <label asp-for="lastName" class="form-label"></label>
                            <input asp-for="lastName" class="form-control" placeholder="ex: Dela Cruz" />
                            <span asp-validation-for="lastName" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Gender" class="form-label"></label>
                        <select asp-for="Gender" asp-items="@(Html.GetEnumSelectList<PersonsGender>())" class="form-control">
                            <option value="">Select Gender</option>
                        </select>
                        <span asp-validation-for="Gender" class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control" placeholder="ex: name@example.com" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="contactNumber" class="form-label"></label>
                            <input asp-for="contactNumber" class="form-control" placeholder="09XXXXXXXXX" />
                            <span asp-validation-for="contactNumber" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="birthDate" class="form-label"></label>
                            <input asp-for="birthDate" class="form-control" type="date" value="@DateOnly.FromDateTime(DateTime.UtcNow).ToString("yyyy-MM-dd")" />
                            <span asp-validation-for="birthDate" class="text-danger"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="Occupation" class="form-label"></label>
                            <input asp-for="Occupation" class="form-control" placeholder="ex: Software Developer" />
                            <span asp-validation-for="Occupation" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <input type="submit" value="Create" class="btn btn-primary" />
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>